rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'email', 'project_type', 'message', 'is_read', 'status', 'created_at', 'updated_at'
      ]) && request.resource.data.name is string && request.resource.data.name.size() <= 200 &&
        request.resource.data.email is string && request.resource.data.email.size() <= 320 &&
        request.resource.data.project_type is string && request.resource.data.project_type.size() <= 200 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 10000 &&
        request.resource.data.is_read == false && request.resource.data.status == 'unread';
      allow read, update, delete: if isAdmin();
    }

    match /media_assets/{assetId} {
      allow read, write: if isAdmin();
    }

    match /{collectionName}/{documentId} {
      allow read: if isAdmin() ||
        collectionName in ['profiles', 'hero_settings', 'site_settings', 'seo_settings', 'project_categories', 'project_media'] ||
        (collectionName in ['projects', 'career_entries', 'education_entries', 'services', 'skills', 'process_steps'] && resource.data.published == true) ||
        (collectionName == 'social_links' && resource.data.enabled == true);
      allow create, update, delete: if isAdmin() && collectionName in [
        'profiles', 'hero_settings', 'site_settings', 'seo_settings', 'project_categories',
        'project_media', 'projects', 'career_entries', 'education_entries',
        'services', 'skills', 'process_steps', 'social_links'
      ];
    }
  }
}
